# Maintainer: KDE Fusion contributors <kdefusion@example.invalid>
pkgname=kde-fusion
pkgver=0.1.0
pkgrel=1
pkgdesc="KDE-native desktop mirroring and extending over Sunshine and Moonlight"
arch=('x86_64')
url="https://example.invalid/kde-fusion"
license=('GPL-3.0-or-later')
depends=(
  'curl'
  'kirigami'
  'krfb'
  'kscreen'
  'libnotify'
  'libsecret'
  'moonlight-qt'
  'polkit'
  'qt6-declarative'
  'qt6-wayland'
  'sunshine'
)
makedepends=('cargo' 'rust')
optdepends=(
  'intel-media-driver: VA-API encoding on Intel GPUs'
  'libva-mesa-driver: VA-API encoding on AMD GPUs'
  'libva-utils: encoder diagnostics (vainfo)'
  'pipewire-pulse: system audio streaming'
)
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CARGO_HOME="${CARGO_HOME:-$srcdir/cargo-home}"
  cargo build --release --locked --jobs "${CARGO_BUILD_JOBS:-2}"
}

package() {
  cd "$pkgname-$pkgver"

  install -Dm755 target/release/kdefusiond "$pkgdir/usr/bin/kdefusiond"
  install -Dm755 target/release/kdefusionctl "$pkgdir/usr/bin/kdefusionctl"
  install -Dm755 target/release/kdefusion "$pkgdir/usr/bin/kdefusion"

  install -Dm644 packaging/kdefusion.desktop \
    "$pkgdir/usr/share/applications/kdefusion.desktop"
  install -Dm644 packaging/kdefusion.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/kdefusion.svg"
  install -Dm644 packaging/kdefusion-symbolic.svg \
    "$pkgdir/usr/share/icons/hicolor/symbolic/apps/kdefusion-symbolic.svg"

  install -d "$pkgdir/usr/share/kdefusion"
  cp -a qml "$pkgdir/usr/share/kdefusion/qml"

  install -Dm644 systemd/kdefusiond.service \
    "$pkgdir/usr/lib/systemd/user/kdefusiond.service"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/PROTOCOL.md "$pkgdir/usr/share/doc/$pkgname/PROTOCOL.md"
  install -Dm644 docs/TROUBLESHOOTING.md \
    "$pkgdir/usr/share/doc/$pkgname/TROUBLESHOOTING.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# vim:set ts=2 sw=2 et:
